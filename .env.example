# Database
POSTGRES_USER=medrad
POSTGRES_PASSWORD=generate-a-unique-database-password
POSTGRES_DB=medrad_db
# Used by local non-Compose commands. Compose builds its private database URL
# from the three values above so the application connects to the postgres service.
DATABASE_URL=postgresql://medrad:generate-a-unique-database-password@localhost:5432/medrad_db

# Security
APP_ENV=development
ENABLE_API_DOCS=true
RUN_STARTUP_MIGRATIONS=false
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=medrad-api
JWT_AUDIENCE=medrad-web
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_WINDOW_SECONDS=3600

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://medcodesolution.com","https://medcodesolution.com"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
API_RATE_LIMIT=600
API_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_SIZE=16777216
SLOW_REQUEST_THRESHOLD_MS=1000
# Audit records remain complete. This controls routine operational request logs only.
REQUEST_LOG_SUCCESS_SAMPLE_RATE=0.10

# Database connection pool
BACKEND_WORKERS=2
# Pool limits are per API worker. Defaults below cap two workers at 32 API connections.
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=8
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Private payment-proof storage and asynchronous OCR. Use `s3` with a private
# DigitalOcean Space for horizontally scaled production deployments.
PAYMENT_PROOF_STORAGE_BACKEND=local
PAYMENT_PROOF_S3_ENDPOINT_URL=https://your-region.digitaloceanspaces.com
PAYMENT_PROOF_S3_REGION=your-region
PAYMENT_PROOF_S3_BUCKET=
PAYMENT_PROOF_S3_ACCESS_KEY_ID=
PAYMENT_PROOF_S3_SECRET_ACCESS_KEY=
PAYMENT_PROOF_S3_PREFIX=payment-proofs
# Leave blank for DigitalOcean Spaces. AWS S3 may use AES256.
PAYMENT_PROOF_S3_SERVER_SIDE_ENCRYPTION=
PAYMENT_PROOF_OCR_POLL_SECONDS=2
PAYMENT_PROOF_OCR_BATCH_SIZE=4
PAYMENT_PROOF_OCR_MAX_ATTEMPTS=4
PAYMENT_PROOF_OCR_LEASE_SECONDS=900

# AI payment-proof extraction (Claude vision). When enabled, cheques and bank
# slips are read by the vision model and reconciled against the invoice amount,
# instead of on-box OCR. Requires an Anthropic API key. Leave disabled to use OCR.
# Model: claude-sonnet-5 (recommended) or claude-haiku-4-5 (cheapest).
# Enabling this sends the complete private proof document to the configured AI
# provider. Confirm the applicable DPA, retention, and zero-data-retention terms
# before acknowledging external processing in production.
# Reading the label on a captured part. Runs after the capture is saved,
# never in front of the shutter. OCR is local; the UDI lookup calls the FDA
# device registry through openFDA, which is free and needs no key. Set
# UDI_LOOKUP_ENABLED=false to keep the capture path entirely offline.
CAPTURE_LABEL_READING_ENABLED=true
CAPTURE_LABEL_OCR_ENABLED=true
UDI_LOOKUP_ENABLED=true
UDI_LOOKUP_TIMEOUT_SECONDS=6.0

AI_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
AI_EXTRACTION_MODEL=claude-sonnet-5
AI_EXTRACTION_TIMEOUT_SECONDS=60
AI_EXTRACTION_EXTERNAL_PROCESSING_ACKNOWLEDGED=false

# ── Assistant (Phia) ──────────────────────────────────────────────────────────
# Super Admin assistant: answers from live data and documents, and prepares work
# orders, service bookings, inspection plans and work order updates for a person
# to confirm. Runs as its own container with no database credentials.
#
# ASSISTANT_INTERNAL_KEY is a password you generate, not a provider key. It lets
# the backend and the agent trust each other. Production refuses anything under
# 32 characters. Generate with:  openssl rand -hex 32
ASSISTANT_ENABLED=false
ASSISTANT_INTERNAL_KEY=

# Primary and fallback providers: groq | openrouter | anthropic | openai
# ("openai" = any OpenAI-compatible endpoint, set AGENT_BASE_URL). When the
# primary is rate limited or down, the turn continues on the fallback.
AGENT_PROVIDER=groq
AGENT_FALLBACK_PROVIDER=openrouter
GROQ_API_KEY=
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY (above) is used only when a provider is anthropic.

# Models per role. Leave empty for the provider defaults in
# agent-service/app/config.py. Check current IDs in each provider's catalogue
# before setting one: a retired model fails at question time.
#   router    - one structured word per question; the smallest model is fine
#   tools     - chooses lookups and actions; give this the strongest model
#   synthesis - writes the answer from the evidence
AGENT_ROUTER_MODEL=
AGENT_TOOLS_MODEL=
AGENT_SYNTHESIS_MODEL=
AGENT_FALLBACK_ROUTER_MODEL=
AGENT_FALLBACK_TOOLS_MODEL=
AGENT_FALLBACK_SYNTHESIS_MODEL=
# One model for every primary role at once. Leave empty unless you mean it:
# a Claude model name here would be sent to Groq.
AGENT_MODEL=

# Only for AGENT_PROVIDER=openai, e.g. a local Ollama:
#   AGENT_BASE_URL=http://ollama:11434/v1   (AGENT_API_KEY may be blank)
AGENT_BASE_URL=
AGENT_API_KEY=

# Every hosted provider receives question text and tool results. Only a local
# endpoint avoids that.
#
# What the assistant calls itself; the widget header is set in
# frontend/src/components/Assistant, so change both together.
AGENT_NAME=Phia
AGENT_LOG_LEVEL=INFO

# Voice. Self-hosted and CPU-only: Piper for speech, faster-whisper for
# transcription. Both models are baked into the image, so no download happens at
# runtime and no audio ever leaves your server. Shares ASSISTANT_INTERNAL_KEY.
# Browse voices at https://rhasspy.github.io/piper-samples/ — changing
# PIPER_VOICE requires rebuilding the speech image, which fetches that voice.
PIPER_VOICE=en_US-ryan-medium
# tiny.en is faster and lighter; small.en is more accurate and roughly 2x the
# memory. base.en is the balance.
WHISPER_MODEL=base.en

# After deploying, create the tables and populate the knowledge base:
#   docker compose exec backend alembic upgrade head
#   docker compose exec backend python -m scripts.generate_kb --write
# Re-run generate_kb on any deploy that changes models, schemas or routes.
# Ensure the edge proxy blocks /internal/ from the public internet.

# Face Recognition
FACE_RECOGNITION_TOLERANCE=0.6
FACE_RECOGNITION_MIN_CONFIDENCE=0.85

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=billing@your-domain.com
PUBLIC_APP_URL=https://medcodesolution.com

# Temporary QA-only simulated payments. Disable when a real gateway is connected.
ENABLE_TEST_PAYMENTS=false

# Square Sandbox
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_CURRENCY=USD
SQUARE_API_VERSION=2026-07-15
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://medcodesolution.com/api/v1/webhooks/square
# Generate a Fernet key outside source control. For rotation use NEW_KEY,OLD_KEY.
# Never remove OLD_KEY until all saved references have been re-encrypted.
PAYMENT_DATA_ENCRYPTION_KEYS=
# Run the recurring rental billing/receipt worker every 15 minutes.
RENTAL_BILLING_INTERVAL_SECONDS=900

# Redis
REDIS_URL=redis://localhost:6379/0
WEBSOCKET_CHANNEL_PREFIX=medrad:realtime
WEBSOCKET_PRESENCE_TTL_SECONDS=45
# Short-lived cache for safe, read-heavy API responses. Financial, stock,
# authorization, permission, and workflow-state reads are intentionally excluded.
READ_CACHE_ENABLED=true
READ_CACHE_PREFIX=medrad:cache
READ_CACHE_DEFAULT_TTL_SECONDS=30
READ_CACHE_LOCK_SECONDS=10
READ_CACHE_LOCK_WAIT_MS=150

# Frontend
VITE_API_URL=https://medcodesolution.com/api/v1
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_TURN_URLS=turn:your-domain.com:3478?transport=udp,turn:your-domain.com:3478?transport=tcp
VITE_TURN_USERNAME=medrad
VITE_TURN_CREDENTIAL=change-this-turn-password

# TURN relay for production WebRTC calls
TURN_REALM=your-domain.com
TURN_EXTERNAL_IP=your-server-public-ip
TURN_USERNAME=medrad
TURN_PASSWORD=change-this-turn-password
