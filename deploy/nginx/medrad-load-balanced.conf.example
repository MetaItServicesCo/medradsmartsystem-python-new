# Reference upstream for a multi-node DigitalOcean deployment.
# Keep the existing 127.0.0.1 upstream on a single-node deployment. Replace
# the private IP placeholders only after a second application node is ready.
upstream medrad_api {
    least_conn;
    server APP_PRIVATE_IP_1:8000 max_fails=3 fail_timeout=10s;
    server APP_PRIVATE_IP_2:8000 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl http2;
    server_name api.medcodesolution.com;

    # Reuse the production certificate and security headers already configured
    # on the host. This file intentionally does not duplicate secret paths.
    # Carries both the chat socket and the assistant's live microphone
    # (/api/v1/ws/assistant-voice/...). Anything needing an upgrade must live
    # under this prefix: the catch-all below sets Connection "" and would turn
    # the handshake into an ordinary request.
    location /api/v1/ws/ {
        proxy_pass http://medrad_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://medrad_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }
}
