# phealth — single-node vhost, frontend and API on one hostname.
#
# Both containers bind 127.0.0.1 only, so nginx is the sole public entrance.
# Ports here assume phealth is sharing a host with another stack; on a host of
# its own they are the compose defaults, 3000 and 8000.
#
# Install:
#   cp deploy/nginx/phealth.conf.example /etc/nginx/sites-available/phealth
#   # edit server_name and the two ports
#   ln -sf /etc/nginx/sites-available/phealth /etc/nginx/sites-enabled/phealth
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d example.com -d www.example.com
#
# Add TLS with certbot *after* this is serving on port 80: it appends the 443
# block, the certificate paths and the HTTP redirect itself, in the syntax the
# installed nginx supports. Writing the 443 block by hand invites two problems
# — `http2 on;` needs nginx 1.25.1+, and a hand-written port-80 redirect
# swallows /.well-known/acme-challenge/ so the certificate can never be issued.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # Behind a CDN every request arrives from an edge address. Without this the
    # per-IP login rate limiter sees a single client and throttles everyone at
    # once. Drop both lines if nothing proxies this host.
    real_ip_header CF-Connecting-IP;
    set_real_ip_from 0.0.0.0/0;

    client_max_body_size 32m;

    # Must precede the catch-alls: they set Connection "", which turns an
    # upgrade handshake into an ordinary request and breaks every socket.
    location /api/v1/ws/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://127.0.0.1:8010;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
